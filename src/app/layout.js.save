// src/app/layout.js
import './globals.css';
import ClientLayoutWrapper from './ClientWrapper';
import SEOHead from '@/components/SEOHead';
import { Inter } from 'next/font/google';

// ✅ Use next/font for better performance & no layout shift
const inter = Inter({
  subsets: ['latin'],
  display: 'swap',
});

export const metadata = {
  metadataBase: new URL("https://mshahrukhengineeringworks.com"), // ✅ your production domain
  title: {
    default: "M. Shahrukh Engineering Works",
    template: "%s | MSEW",
  },
  description: "Discover durable, energy-efficient removable insulation jackets for generators, valves, pumps, turbines, and industrial equipment. Custom solutions available across Pakistan and internationally",
  openGraph: {
    title: "M. Shahrukh Engineering Works",
    description: "Premium insulation jackets & industrial solutions",
    url: "https://mshahrukhengineeringworks.com",
    siteName: "MSEW",
    images: [
      {
        url: "https://mshahrukhengineeringworks.com/og-image.jpg", // replace with real OG image
        width: 1200,
        height: 630,
        alt: "MSEW Insulation Solutions",
      },
    ],
    locale: "en_AU",
    type: "website",
  },
  twitter: {
    card: "summary_large_image",
    title: "M. Shahrukh Engineering Works",
    description: "Premium insulation jackets & industrial solutions",
    images: ["https://mshahrukhengineeringworks.com/og-image.jpg"], // replace with real Twitter image
  },
};

export default function RootLayout({ children, seo }) {
  // Default SEO values
  const defaultSEO = {
    title: metadata.title,
    description: metadata.description,
    image: '/default-image.png',
  };

  const seoProps = { ...defaultSEO, ...seo };

  return (
    <html lang="en" suppressHydrationWarning>
      <Head>	
      <body className={`${inter.className} overflow-x-hidden`}>
        {/* ✅ Centralized SEO (dynamic override still supported) */}
        <SEOHead {...seoProps} />

        {/* ✅ Your client-side wrapper stays untouched */}
        <ClientLayoutWrapper>{children}</ClientLayoutWrapper>

        {/* ✅ For portals (mobile menu, modals, etc.) */}
        <div id="mobile-menu-root"></div>
      </body>
    </html>
  );
}
